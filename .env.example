# Ironclad LMS API - Environment Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control!

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# For Docker Compose (local): postgresql://ironclad:ironclad_secure_password@postgres:5432/ironclad_db
# For AWS RDS: postgresql://ironclad:password@your-rds-endpoint.rds.amazonaws.com:5432/ironclad_db
DATABASE_URL=postgresql://ironclad:ironclad_secure_password@postgres:5432/ironclad_db

# ==============================================
# JWT AUTHENTICATION
# ==============================================
# JWT secret key (use strong random string, min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration time
JWT_EXPIRE_IN=24h

# Refresh token secret (use strong random string)
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key

# Refresh token expiration time
REFRESH_TOKEN_EXPIRE_IN=7d

# ==============================================
# AWS CONFIGURATION (for S3 video storage)
# ==============================================
# AWS region where S3 bucket is located
AWS_REGION=us-east-1

# S3 bucket name for storing videos and files
AWS_S3_BUCKET=ironclad-videos-bucket-name

# AWS IAM user access key ID
# Generate from AWS IAM console
AWS_ACCESS_KEY_ID=AKIA2EXAMPLE12345678

# AWS IAM user secret access key
# Generate from AWS IAM console
AWS_SECRET_ACCESS_KEY=your-secret-access-key-string

# (Optional) AWS role ARN for transcription service
AWS_TRANSCRIBE_ROLE_ARN=arn:aws:iam::YOUR-ACCOUNT-ID:role/transcribe-role

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
# Node environment (development, production, staging)
NODE_ENV=development

# Port the API server will listen on
PORT=3000

# Full API URL (used for OAuth callbacks, emails, etc.)
API_URL=http://localhost:3000

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:3001

# ==============================================
# EMAIL CONFIGURATION (SMTP)
# ==============================================
# SMTP server hostname
SMTP_HOST=smtp.gmail.com

# SMTP port (usually 587 for TLS or 465 for SSL)
SMTP_PORT=587

# Email address for sending emails
SMTP_USER=your-email@gmail.com

# Email password or app-specific password
SMTP_PASSWORD=your-app-password

# Email from name
SMTP_FROM_NAME=Ironclad LMS

# Email from address
SMTP_FROM_EMAIL=noreply@ironclad.com

# ==============================================
# OPENAI CONFIGURATION (for AI features)
# ==============================================
# OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use
OPENAI_MODEL=gpt-3.5-turbo

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
# Log level (error, warn, debug, verbose)
LOG_LEVEL=debug

# ==============================================
# CORS CONFIGURATION
# ==============================================
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3001,https://yourdomain.com

# Allow credentials in CORS
CORS_CREDENTIALS=true

# ==============================================
# RATE LIMITING
# ==============================================
# Request rate limit per minute per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=500

# Allowed file types
ALLOWED_FILE_TYPES=mp4,webm,mov,avi,mkv

# ==============================================
# DATABASE POOL CONFIGURATION
# ==============================================
# Connection pool size
DATABASE_POOL_SIZE=20

# Connection pool timeout in milliseconds
DATABASE_POOL_TIMEOUT=5000

# ==============================================
# SECURITY
# ==============================================
# Session secret for express-session
SESSION_SECRET=your-session-secret-key

# CORS allow all (not recommended for production)
CORS_ALLOW_ALL=false

# ==============================================
# EXAMPLE VALUES FOR DEVELOPMENT
# ==============================================
# Uncomment these for quick local development setup

# DATABASE_URL=postgresql://ironclad:password@localhost:5432/ironclad_db
# JWT_SECRET=dev-secret-key-do-not-use-in-production-12345678
# REFRESH_TOKEN_SECRET=dev-refresh-secret-key-do-not-use-in-production
# NODE_ENV=development
# PORT=3000
# API_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:3001
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=local-bucket-name-for-dev
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587

# ==============================================
# NOTES
# ==============================================
# 1. All required fields must be set for the app to run
# 2. Keep this file secure and never commit it to git
# 3. Use AWS Secrets Manager or similar for production
# 4. Rotate credentials periodically
# 5. Use strong, random values for all secrets
# 6. For AWS: Create IAM user with minimal required permissions
